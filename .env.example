# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers → Node.js).
# Replace <db_password> with your database user's password. URL-encode special characters (@ : / ? # %).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=pal

# First-run owner account (created only if no admin exists yet).
# If ADMIN_PASSWORD is omitted a random one is generated and printed once in the server console.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

PORT=4000
# Uploaded gallery images + private expense receipts are stored in this folder.
DATA_DIR=data
APP_TIMEZONE=Asia/Kolkata

# Production over HTTPS:
# COOKIE_SECURE=true
# TRUST_PROXY=1
